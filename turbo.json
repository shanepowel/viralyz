{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:push": {
      "cache": false
    }
  },
  "globalEnv": [
    "CONTACT_FROM_EMAIL",
    "CONTACT_TO_EMAIL",
    "RESEND_API_KEY",
    "RESEND_AUDIENCE_ID",
    "SANITY_API_READ_TOKEN",
    "SANITY_HOME",
    "SANITY_REVALIDATE_SECRET",
    "NEXT_SERVER_ACTIONS_ENCRYPTION_KEY"
  ]
}
